# ── App ────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Database (PostgreSQL) ────────────────────────
DATABASE_URL=postgresql://nexzee:nexzee_password@localhost:5432/nexzee_db

# ── Auth ──────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Paystack (Phase 3) ────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Not used by signature verification (see webhookSignature.ts) — kept for
# forward-compatibility only. Paystack's classic HMAC scheme signs with
# PAYSTACK_SECRET_KEY, not a separate webhook secret.
PAYSTACK_WEBHOOK_SECRET=
# Bank slug for dedicated virtual accounts. Confirm what's actually
# available to your Paystack account via GET /dedicated_account/available_providers
PAYSTACK_PREFERRED_BANK=wema-bank
# Where Paystack redirects the browser after a card payment completes
PAYSTACK_CALLBACK_URL=http://localhost:5173/fund-wallet

# ── Peyflex (Phase 4) ──────────────────────────────
PEYFLEX_API_KEY=
PEYFLEX_BASE_URL=https://client.peyflex.com.ng

# ── Admin bootstrap (Phase 7) ─────────────────────
# Only read by `npm run prisma:seed`, not by the running app. Creates the
# first SUPER_ADMIN account — set these once, run the seed, then unset them
# (or at least change the password immediately after first login).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Super Admin
