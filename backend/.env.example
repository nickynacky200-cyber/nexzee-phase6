# ── App ────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────
DATABASE_URL=postgresql://nexzee:nexzee_password@localhost:5432/nexzee_db

# ── Auth ──────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Paystack (Phase 3) ────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Peyflex (Phase 4) ──────────────────────────────
PEYFLEX_API_KEY=
PEYFLEX_BASE_URL=https://client.peyflex.com.ng
